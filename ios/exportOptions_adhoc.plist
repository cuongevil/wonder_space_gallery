<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <!-- Phương thức phát hành -->
  <key>method</key>
  <string>ad-hoc</string>

  <!-- Team ID (chuẩn Apple Developer Team) -->
  <key>teamID</key>
  <string>CS2UV6F3ZY</string>

  <!-- Provisioning profile cho từng bundle ID -->
  <key>provisioningProfiles</key>
  <dict>
    <key>com.ctmd.wonderforge.wonderspace.gallery</key>
    <string>wonderspace_gallery_adhoc</string>
  </dict>

  <!-- Phong cách ký thủ công -->
  <key>signingStyle</key>
  <string>manual</string>

  <!-- Certificate phát hành -->
  <key>signingCertificate</key>
  <string>Apple Distribution</string>

  <!-- Vô hiệu hóa Bitcode (Apple đã ngừng hỗ trợ) -->
  <key>compileBitcode</key>
  <false/>

  <!-- Xuất ra universal IPA (không chia mảnh) -->
  <key>thinning</key>
  <string>&lt;none&gt;</string>

  <!-- Giữ lại Swift symbols để phân tích crash -->
  <key>stripSwiftSymbols</key>
  <true/>

  <!-- Mục tiêu export -->
  <key>destination</key>
  <string>export</string>

  <!-- Cho phép quản lý phiên bản ứng dụng -->
  <key>manageAppVersionAndBuildNumber</key>
  <true/>

</dict>
</plist>
