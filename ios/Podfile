# ===========================================
# Wonder Space Gallery - Podfile v11.6.1 FINAL
# ✅ Disable provisioning for all Pods
# ✅ Manual signing for Runner only
# ✅ Fix 'Flutter/Flutter.h' + 'No such module Flutter'
# ✅ iOS Deployment Target >= 15.0
# ===========================================

platform :ios, '15.0'
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  raise "#{generated_xcode_build_settings_path} must exist. Run flutter pub get first." unless File.exist?(generated_xcode_build_settings_path)
  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)
flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

# ===========================================
# POST INSTALL CLEANUP & SEARCH PATH FIX
# ===========================================
post_install do |installer|
  puts "🚧 Cleaning signing for Pods & setting manual for Runner..."

  flutter_framework_path = File.join(File.dirname(__FILE__), 'Flutter')

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # 🔧 Disable signing for all Pods
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['CODE_SIGN_STYLE'] = 'Automatic'
      config.build_settings['CODE_SIGN_IDENTITY'] = ''
      config.build_settings['PROVISIONING_PROFILE_SPECIFIER'] = ''
      config.build_settings['DEVELOPMENT_TEAM'] = ''

      # 📱 Minimum iOS target = 15.0
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end

      # 🧩 Add Flutter.framework search path for all Pods
      config.build_settings['FRAMEWORK_SEARCH_PATHS'] ||= ['$(inherited)']
      unless config.build_settings['FRAMEWORK_SEARCH_PATHS'].include?(flutter_framework_path)
        config.build_settings['FRAMEWORK_SEARCH_PATHS'] << flutter_framework_path
      end

      # 🧩 Add explicit $(PROJECT_DIR)/Flutter for Swift module visibility
      unless config.build_settings['FRAMEWORK_SEARCH_PATHS'].include?('$(PROJECT_DIR)/Flutter')
        config.build_settings['FRAMEWORK_SEARCH_PATHS'] << '$(PROJECT_DIR)/Flutter'
      end
    end
  end

  # ✅ Manual signing for Runner only
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.native_targets.each do |target|
      next unless target.name == 'Runner'
      target.build_configurations.each do |config|
        config.build_settings['CODE_SIGN_STYLE'] = 'Manual'
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'YES'
        config.build_settings['CODE_SIGN_IDENTITY'] = 'Apple Distribution: Cuong Nguyen Ba (CS2UV6F3ZY)'
        config.build_settings['DEVELOPMENT_TEAM'] = 'CS2UV6F3ZY'
        config.build_settings['PROVISIONING_PROFILE_SPECIFIER'] = 'wonderspace_gallery_adhoc'
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end

  puts "✅ post_install completed — Pods auto, Runner manual, all pods see Flutter.framework & module Flutter."
end
